#: extension.js:64
#, javascript-format
msgid "Could not generate the configuration: %s"
msgstr "配置生成错误：%s"

#: extension.js:74
#, javascript-format
msgid "Could not start the sing-box backend: %s"
msgstr "无法启动 TUN 后端：%s"

#: extension.js:82
#, javascript-format
msgid "Connecting to %s"
msgstr "正在连接 %s"

#: extension.js:176
msgid "This subscription has no cached configuration yet"
msgstr "此订阅还没有缓存的配置"

#: extension.js:210
#, javascript-format
msgid "%s disconnected"
msgstr "%s 已断开"

#: extension.js:216
#, javascript-format
msgid "%s stopped: %s"
msgstr "%s 已停止：%s"

#: extension.js:218
msgid "sing-box exited unexpectedly"
msgstr "sing-box 意外退出"

#: extension.js:228 extension.js:238 extension.js:270
msgid "Off"
msgstr "已关闭"

#: extension.js:253
msgid "Preferences…"
msgstr "首选项…"

#: extension.js:270
#, javascript-format
msgid "On · %s"
msgstr "已开启 · %s"

#: extension.js:274
#, javascript-format
msgid "Status: %s"
msgstr "状态：%s"

#: extension.js:277
msgid "No connections yet, click to import"
msgstr "暂无连接，点击导入"

#: extension.js:303
msgid "No connections available, import one first"
msgstr "暂无可用连接，请先导入"

#: prefs.js:57
msgid "Subscription"
msgstr "订阅"

#: prefs.js:70
msgid "Delete this connection"
msgstr "删除连接"

#: prefs.js:102
msgid "Connections"
msgstr "连接列表"

#: prefs.js:103
msgid ""
"Import sing-box connections from a URL or a QR code. The list is ordered by "
"country."
msgstr "通过 URL 或二维码导入 sing-box 连接，列表按国家/地区排序。"

#: prefs.js:117
msgid "Connection deleted"
msgstr "连接已删除"

#: prefs.js:122
msgid "No connections yet"
msgstr "暂无连接"

#: prefs.js:123
msgid "Paste a URL below, or pick a QR code image"
msgstr "在下方粘贴 URL，或选择二维码图片"

#: prefs.js:128
msgid "Import a connection"
msgstr "导入连接"

#: prefs.js:130
msgid "Connection URL"
msgstr "连接 URL"

#: prefs.js:131
msgid "Connection name"
msgstr "连接名称"

#: prefs.js:133
msgid "Country or region"
msgstr "国家/地区"

#: prefs.js:142
msgid "Connection imported"
msgstr "连接已导入"

#: prefs.js:153
#, javascript-format
msgid "That subscription link is malformed: %s"
msgstr "订阅链接格式有误：%s"

#: prefs.js:161
msgid "A subscription URL must use https"
msgstr "订阅链接必须使用 https"

#: prefs.js:165
msgid "Fetching the subscription…"
msgstr "正在获取订阅…"

#: prefs.js:168
#, javascript-format
msgid "Could not fetch the subscription: %s"
msgstr "无法获取订阅：%s"

#: prefs.js:174
#, javascript-format
msgid "The subscription did not return a usable configuration: %s"
msgstr "订阅返回的配置不可用：%s"

#: prefs.js:184
msgid "Unnamed subscription"
msgstr "未命名订阅"

#: prefs.js:196
msgid "That is not a supported sing-box share link"
msgstr "请输入有效的 sing-box 分享链接"

#: prefs.js:207
msgid "Unnamed connection"
msgstr "未命名连接"

#: prefs.js:219 prefs.js:254
msgid "Import"
msgstr "导入"

#: prefs.js:240
msgid "Import one subscription first, or paste a subscription link above"
msgstr "请先导入一个订阅，或在上方粘贴订阅链接"

#: prefs.js:248
#, javascript-format
msgid "Could not build the region list URL: %s"
msgstr "无法构造地区列表地址：%s"

#: prefs.js:260
msgid "Fetching the region list…"
msgstr "正在获取地区列表…"

#: prefs.js:266
#, javascript-format
msgid "Could not fetch the region list: %s"
msgstr "获取地区列表失败：%s"

#: prefs.js:274
#, javascript-format
msgid "The region list is not valid JSON: %s"
msgstr "地区列表不是合法的 JSON：%s"

#: prefs.js:278
msgid "The region list came back empty"
msgstr "地区列表是空的"

#: prefs.js:290
#, javascript-format
msgid "Nothing to import: all %s regions are already here"
msgstr "无需导入：%s 个地区都已存在"

#: prefs.js:304
#, javascript-format
msgid "Imported %s, skipped %s, failed %s"
msgstr "已导入 %s 个，跳过 %s 个，失败 %s 个"

#: prefs.js:310
#, javascript-format
msgid "Importing… %s/%s"
msgstr "正在导入… %s/%s"

#: prefs.js:348
msgid "Import all from anyfq.com"
msgstr "从 anyfq.com 批量导入"

#: prefs.js:349
msgid "Fetches every region at once, skipping the ones you already have"
msgstr "一次拉取全部地区，已有的自动跳过"

#: prefs.js:360
msgid "Import URL"
msgstr "导入 URL"

#: prefs.js:369
msgid "Import from a QR image"
msgstr "从二维码图片导入"

#: prefs.js:381
msgid "TUN backend"
msgstr "TUN 后端"

#: prefs.js:382
msgid ""
"The generated sing-box TUN configuration is passed to this command. sing-box "
"needs permission to create a TUN device and change routes."
msgstr ""
"启动连接时，扩展会生成 sing-box TUN 配置并传给此命令。需要 sing-box 具备创建 "
"TUN 和修改路由的权限。"

#: prefs.js:385
msgid "Start command"
msgstr "启动命令"

#: prefs.js:393
msgid "Start command saved"
msgstr "启动命令已保存"

#: prefs.js:408
msgid "QR images need the zbarimg tool: install the zbar-tools package"
msgstr "二维码导入需要 zbarimg 工具：请安装 zbar-tools 包"

#: prefs.js:412
msgid "Choose a QR code image"
msgstr "选择二维码图片"

#: prefs.js:430
#, javascript-format
msgid "Could not run zbarimg: %s"
msgstr "无法运行 zbarimg：%s"

#: prefs.js:439
#, javascript-format
msgid "Could not read the QR image: %s"
msgstr "无法读取二维码图片：%s"

#: prefs.js:445
msgid "No QR code was found in that image"
msgstr "图片中未检测到二维码"

#~ msgid "Not connected"
#~ msgstr "未连接"

#~ msgid "Open control panel"
#~ msgstr "打开控制面板"

#~ msgid "zbarimg is not installed, so QR images cannot be read"
#~ msgstr "未安装 zbarimg，无法读取二维码图片"
