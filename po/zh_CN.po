#: extension.js:68
#, javascript-format
msgid "Could not generate the configuration: %s"
msgstr "配置生成错误：%s"

#: extension.js:78
#, javascript-format
msgid "Could not start the sing-box backend: %s"
msgstr "无法启动 TUN 后端：%s"

#: extension.js:86
#, javascript-format
msgid "Connecting to %s"
msgstr "正在连接 %s"

#: extension.js:180
msgid "This subscription has no cached configuration yet"
msgstr "此订阅还没有缓存的配置"

#: extension.js:214
#, javascript-format
msgid "%s disconnected"
msgstr "%s 已断开"

#: extension.js:220
#, javascript-format
msgid "%s stopped: %s"
msgstr "%s 已停止：%s"

#: extension.js:222
msgid "sing-box exited unexpectedly"
msgstr "sing-box 意外退出"

#: extension.js:232 extension.js:242 extension.js:274
msgid "Off"
msgstr "已关闭"

#: extension.js:257
msgid "Preferences…"
msgstr "首选项…"

#: extension.js:274
#, javascript-format
msgid "On · %s"
msgstr "已开启 · %s"

#: extension.js:278
#, javascript-format
msgid "Status: %s"
msgstr "状态：%s"

#: extension.js:281
msgid "No connections yet, click to import"
msgstr "暂无连接，点击导入"

#: extension.js:293
#, javascript-format
msgid "Server: %s"
msgstr "服务器：%s"

#: extension.js:293
msgid "None"
msgstr "未选择"

#: extension.js:345
msgid "No connections available, import one first"
msgstr "暂无可用连接，请先导入"

#: prefs.js:50
msgid "These subscriptions belong to a different account"
msgstr "这些订阅属于另一个账号"

#: prefs.js:52
#, javascript-format
msgid ""
"The %s subscriptions already here belong to %s, but this import belongs to "
"%s. Replace them?"
msgstr "现有的 %s 条订阅属于 %s，而本次导入属于 %s。要替换掉吗？"

#: prefs.js:57 prefs.js:69
msgid "Cancel"
msgstr "取消"

#: prefs.js:58 prefs.js:70
msgid "Replace"
msgstr "替换"

#: prefs.js:98
msgid "Subscription"
msgstr "订阅"

#: prefs.js:111
msgid "Delete this connection"
msgstr "删除连接"

#: prefs.js:143
msgid "Connections"
msgstr "连接列表"

#: prefs.js:144
msgid ""
"Import sing-box connections from a URL or a QR code. The list is ordered by "
"country."
msgstr "通过 URL 或二维码导入 sing-box 连接，列表按国家/地区排序。"

#: prefs.js:158
msgid "Connection deleted"
msgstr "连接已删除"

#: prefs.js:163
msgid "No connections yet"
msgstr "暂无连接"

#: prefs.js:164
msgid "Paste a URL below, or pick a QR code image"
msgstr "在下方粘贴 URL，或选择二维码图片"

#: prefs.js:169
msgid "Import a connection"
msgstr "导入连接"

#: prefs.js:171
msgid "Connection URL"
msgstr "连接 URL"

#: prefs.js:172
msgid "Connection name"
msgstr "连接名称"

#: prefs.js:174
msgid "Country or region"
msgstr "国家/地区"

#: prefs.js:183
msgid "Connection imported"
msgstr "连接已导入"

#: prefs.js:194
#, javascript-format
msgid "That subscription link is malformed: %s"
msgstr "订阅链接格式有误：%s"

#: prefs.js:202
msgid "A subscription URL must use https"
msgstr "订阅链接必须使用 https"

#: prefs.js:206
msgid "Fetching the subscription…"
msgstr "正在获取订阅…"

#: prefs.js:209
#, javascript-format
msgid "Could not fetch the subscription: %s"
msgstr "无法获取订阅：%s"

#: prefs.js:215 prefs.js:344
#, javascript-format
msgid "The subscription did not return a usable configuration: %s"
msgstr "订阅返回的配置不可用：%s"

#: prefs.js:225
msgid "Unnamed subscription"
msgstr "未命名订阅"

#: prefs.js:237
msgid "That is not a supported sing-box share link"
msgstr "请输入有效的 sing-box 分享链接"

#: prefs.js:248
msgid "Unnamed connection"
msgstr "未命名连接"

#: prefs.js:260 prefs.js:300
msgid "Import"
msgstr "导入"

#: prefs.js:286
msgid "Import one subscription first, or paste a subscription link above"
msgstr "请先导入一个订阅，或在上方粘贴订阅链接"

#: prefs.js:294
#, javascript-format
msgid "Could not build the region list URL: %s"
msgstr "无法构造地区列表地址：%s"

#: prefs.js:306
msgid "Fetching the region list…"
msgstr "正在获取地区列表…"

#: prefs.js:312 prefs.js:339
#, javascript-format
msgid "Could not fetch the region list: %s"
msgstr "获取地区列表失败：%s"

#: prefs.js:320
#, javascript-format
msgid "The region list is not valid JSON: %s"
msgstr "地区列表不是合法的 JSON：%s"

#: prefs.js:324
msgid "The region list came back empty"
msgstr "地区列表是空的"

#: prefs.js:336
msgid "Checking the account…"
msgstr "正在核对账号…"

#: prefs.js:356
msgid "Import cancelled"
msgstr "已取消导入"

#: prefs.js:376
#, javascript-format
msgid "Nothing to import: all %s regions are already here"
msgstr "无需导入：%s 个地区都已存在"

#: prefs.js:390
#, javascript-format
msgid "Imported %s, skipped %s, failed %s"
msgstr "已导入 %s 个，跳过 %s 个，失败 %s 个"

#: prefs.js:396
#, javascript-format
msgid "Importing… %s/%s"
msgstr "正在导入… %s/%s"

#: prefs.js:435
msgid "Import all from anyfq.com"
msgstr "从 anyfq.com 批量导入"

#: prefs.js:436
msgid "Fetches every region at once, skipping the ones you already have"
msgstr "一次拉取全部地区，已有的自动跳过"

#: prefs.js:447
msgid "Import URL"
msgstr "导入 URL"

#: prefs.js:456
msgid "Import from a QR image"
msgstr "从二维码图片导入"

#: prefs.js:468
msgid "TUN backend"
msgstr "TUN 后端"

#: prefs.js:469
msgid ""
"The generated sing-box TUN configuration is passed to this command. sing-box "
"needs permission to create a TUN device and change routes."
msgstr ""
"启动连接时，扩展会生成 sing-box TUN 配置并传给此命令。需要 sing-box 具备创建 "
"TUN 和修改路由的权限。"

#: prefs.js:472
msgid "Start command"
msgstr "启动命令"

#: prefs.js:480
msgid "Start command saved"
msgstr "启动命令已保存"

#: prefs.js:495
msgid "QR images need the zbarimg tool: install the zbar-tools package"
msgstr "二维码导入需要 zbarimg 工具：请安装 zbar-tools 包"

#: prefs.js:499
msgid "Choose a QR code image"
msgstr "选择二维码图片"

#: prefs.js:517
#, javascript-format
msgid "Could not run zbarimg: %s"
msgstr "无法运行 zbarimg：%s"

#: prefs.js:526
#, javascript-format
msgid "Could not read the QR image: %s"
msgstr "无法读取二维码图片：%s"

#: prefs.js:532
msgid "No QR code was found in that image"
msgstr "图片中未检测到二维码"

#~ msgid "Not connected"
#~ msgstr "未连接"

#~ msgid "Open control panel"
#~ msgstr "打开控制面板"

#~ msgid "zbarimg is not installed, so QR images cannot be read"
#~ msgstr "未安装 zbarimg，无法读取二维码图片"
