#: extension.js:61
#, javascript-format
msgid "Could not generate the configuration: %s"
msgstr "配置生成错误：%s"

#: extension.js:70
#, javascript-format
msgid "Could not start the sing-box backend: %s"
msgstr "无法启动 TUN 后端：%s"

#: extension.js:77
#, javascript-format
msgid "Connecting to %s"
msgstr "正在连接 %s"

#: extension.js:147
#, javascript-format
msgid "%s disconnected"
msgstr "%s 已断开"

#: extension.js:153
#, javascript-format
msgid "%s stopped: %s"
msgstr "%s 已停止：%s"

#: extension.js:155
msgid "sing-box exited unexpectedly"
msgstr "sing-box 意外退出"

#: extension.js:165 extension.js:175 extension.js:196
msgid "Not connected"
msgstr "未连接"

#: extension.js:181
msgid "Open control panel"
msgstr "打开控制面板"

#: extension.js:201
msgid "No connections yet, click to import"
msgstr "暂无连接，点击导入"

#: extension.js:227
msgid "No connections available, import one first"
msgstr "暂无可用连接，请先导入"

#: prefs.js:52
msgid "Subscription"
msgstr "订阅"

#: prefs.js:65
msgid "Delete this connection"
msgstr "删除连接"

#: prefs.js:86
msgid "Connections"
msgstr "连接列表"

#: prefs.js:87
msgid ""
"Import sing-box connections from a URL or a QR code. The list is ordered by "
"country."
msgstr "通过 URL 或二维码导入 sing-box 连接，列表按国家/地区排序。"

#: prefs.js:101
msgid "Connection deleted"
msgstr "连接已删除"

#: prefs.js:106
msgid "No connections yet"
msgstr "暂无连接"

#: prefs.js:107
msgid "Paste a URL below, or pick a QR code image"
msgstr "在下方粘贴 URL，或选择二维码图片"

#: prefs.js:112
msgid "Import a connection"
msgstr "导入连接"

#: prefs.js:114
msgid "Connection URL"
msgstr "连接 URL"

#: prefs.js:115
msgid "Connection name"
msgstr "连接名称"

#: prefs.js:117
msgid "Country or region"
msgstr "国家/地区"

#: prefs.js:129
msgid "Connection imported"
msgstr "连接已导入"

#: prefs.js:140
#, javascript-format
msgid "That subscription link is malformed: %s"
msgstr "订阅链接格式有误：%s"

#: prefs.js:144
msgid "Fetching the subscription…"
msgstr "正在获取订阅…"

#: prefs.js:147
#, javascript-format
msgid "Could not fetch the subscription: %s"
msgstr "无法获取订阅：%s"

#: prefs.js:153
#, javascript-format
msgid "The subscription did not return a usable configuration: %s"
msgstr "订阅返回的配置不可用：%s"

#: prefs.js:163
msgid "Unnamed subscription"
msgstr "未命名订阅"

#: prefs.js:175
msgid "That is not a supported sing-box share link"
msgstr "请输入有效的 sing-box 分享链接"

#: prefs.js:186
msgid "Unnamed connection"
msgstr "未命名连接"

#: prefs.js:193
msgid "Import URL"
msgstr "导入 URL"

#: prefs.js:202
msgid "Import from a QR image"
msgstr "从二维码图片导入"

#: prefs.js:214
msgid "TUN backend"
msgstr "TUN 后端"

#: prefs.js:215
msgid ""
"The generated sing-box TUN configuration is passed to this command. sing-box "
"needs permission to create a TUN device and change routes."
msgstr ""
"启动连接时，扩展会生成 sing-box TUN 配置并传给此命令。需要 sing-box 具备创建 "
"TUN 和修改路由的权限。"

#: prefs.js:218
msgid "Start command"
msgstr "启动命令"

#: prefs.js:226
msgid "Start command saved"
msgstr "启动命令已保存"

#: prefs.js:241
msgid "QR images need the zbarimg tool: install the zbar-tools package"
msgstr "二维码导入需要 zbarimg 工具：请安装 zbar-tools 包"

#: prefs.js:245
msgid "Choose a QR code image"
msgstr "选择二维码图片"

#: prefs.js:263
#, javascript-format
msgid "Could not run zbarimg: %s"
msgstr "无法运行 zbarimg：%s"

#: prefs.js:272
#, javascript-format
msgid "Could not read the QR image: %s"
msgstr "无法读取二维码图片：%s"

#: prefs.js:278
msgid "No QR code was found in that image"
msgstr "图片中未检测到二维码"

#~ msgid "zbarimg is not installed, so QR images cannot be read"
#~ msgstr "未安装 zbarimg，无法读取二维码图片"
